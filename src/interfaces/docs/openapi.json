{
  "openapi": "3.0.3",
  "info": {
    "title": "Appointment Booking API",
    "description": "Production-grade appointment booking API with strict conflict prevention under concurrent requests, idempotent cancellation, and real-time Socket.IO broadcasts.\n\n### Authentication\nAuthentication is intentionally omitted as per the specification. All endpoints are publicly accessible.\n\n### Real-time Synchronization (Socket.IO)\nSocket.IO broadcasts events (`slot.booked` and `slot.released`) on the root namespace `/` over path `/socket.io`. Refer to README.md for Socket.IO event details and frontend-free client verification.\n\n### Idempotent Cancellation\nCalling `DELETE /bookings/{bookingId}` on an active booking cancels it, freeing the slot and broadcasting `slot.released`. Repeating the call returns HTTP 200 with the exact same cancelled booking without further state modifications or duplicate events.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Local Development Server"
    }
  ],
  "paths": {
    "/slots": {
      "get": {
        "summary": "Get available appointment slots",
        "description": "Returns available appointment slots only, ordered by `startsAt` ascending, then `id` ascending. A slot is available if it has no active booking. If no slots are available, an empty array is returned.",
        "operationId": "getAvailableSlots",
        "security": [],
        "responses": {
          "200": {
            "description": "Available appointment slots retrieved successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetSlotsResponse"
                },
                "examples": {
                  "availableSlots": {
                    "summary": "List with available slots",
                    "value": {
                      "slots": [
                        {
                          "id": "11111111-1111-4111-8111-111111111111",
                          "startsAt": "2030-01-15T09:00:00.000Z",
                          "endsAt": "2030-01-15T09:30:00.000Z"
                        },
                        {
                          "id": "11111111-1111-4111-8111-111111111112",
                          "startsAt": "2030-01-15T09:30:00.000Z",
                          "endsAt": "2030-01-15T10:00:00.000Z"
                        }
                      ]
                    }
                  },
                  "emptySlots": {
                    "summary": "No slots available",
                    "value": {
                      "slots": []
                    }
                  }
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/bookings": {
      "post": {
        "summary": "Book an appointment slot",
        "description": "Creates an active booking for an available slot. Under concurrent requests for the same slot, exactly one request will succeed (201) and all others will fail with 409 SLOT_UNAVAILABLE.\n\nFields `customerName` and `customerEmail` are automatically trimmed before validation and storage.",
        "operationId": "createBooking",
        "security": [],
        "requestBody": {
          "required": true,
          "description": "Booking creation payload",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BookSlotRequest"
              },
              "examples": {
                "standardBooking": {
                  "summary": "Standard booking request",
                  "value": {
                    "slotId": "11111111-1111-4111-8111-111111111111",
                    "customerName": "Alex Morgan",
                    "customerEmail": "alex@example.com"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Booking successfully created.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BookingResponse"
                },
                "example": {
                  "booking": {
                    "id": "22222222-2222-4222-8222-222222222222",
                    "slotId": "11111111-1111-4111-8111-111111111111",
                    "customerName": "Alex Morgan",
                    "customerEmail": "alex@example.com",
                    "status": "active"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Validation error: invalid/missing fields or malformed JSON.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "missingFields": {
                    "summary": "Invalid or missing field",
                    "value": {
                      "error": {
                        "code": "VALIDATION_ERROR",
                        "message": "customerEmail: customerEmail must have valid email syntax."
                      }
                    }
                  },
                  "malformedJson": {
                    "summary": "Malformed JSON body",
                    "value": {
                      "error": {
                        "code": "VALIDATION_ERROR",
                        "message": "Malformed JSON payload provided in request body."
                      }
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Valid UUID provided for a nonexistent slot.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "SLOT_NOT_FOUND",
                    "message": "Slot not found."
                  }
                }
              }
            }
          },
          "409": {
            "description": "Conflict: an active booking already exists for the requested slot.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "SLOT_UNAVAILABLE",
                    "message": "This slot already has an active booking."
                  }
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/bookings/{bookingId}": {
      "delete": {
        "summary": "Cancel an appointment booking",
        "description": "Transitions an active booking to cancelled status and releases its slot for future bookings. Repeated cancellation is idempotent and returns HTTP 200 with the same cancelled booking without further state modifications or event emissions.",
        "operationId": "cancelBooking",
        "security": [],
        "parameters": [
          {
            "name": "bookingId",
            "in": "path",
            "required": true,
            "description": "UUID of the booking to cancel",
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "example": "22222222-2222-4222-8222-222222222222"
          }
        ],
        "responses": {
          "200": {
            "description": "Booking cancelled successfully, or idempotent response for already cancelled booking.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BookingResponse"
                },
                "example": {
                  "booking": {
                    "id": "22222222-2222-4222-8222-222222222222",
                    "slotId": "11111111-1111-4111-8111-111111111111",
                    "customerName": "Alex Morgan",
                    "customerEmail": "alex@example.com",
                    "status": "cancelled"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Validation error: invalid UUID path parameter.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "VALIDATION_ERROR",
                    "message": "bookingId: bookingId must be a valid UUID."
                  }
                }
              }
            }
          },
          "404": {
            "description": "Valid UUID provided for a nonexistent booking.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "BOOKING_NOT_FOUND",
                    "message": "Booking not found."
                  }
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Slot": {
        "type": "object",
        "required": ["id", "startsAt", "endsAt"],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "Unique identifier of the appointment slot",
            "example": "11111111-1111-4111-8111-111111111111"
          },
          "startsAt": {
            "type": "string",
            "format": "date-time",
            "description": "Fixed slot start time in ISO 8601 UTC format",
            "example": "2030-01-15T09:00:00.000Z"
          },
          "endsAt": {
            "type": "string",
            "format": "date-time",
            "description": "Fixed slot end time in ISO 8601 UTC format (strictly later than startsAt)",
            "example": "2030-01-15T09:30:00.000Z"
          }
        }
      },
      "GetSlotsResponse": {
        "type": "object",
        "required": ["slots"],
        "properties": {
          "slots": {
            "type": "array",
            "description": "Available slots ordered by startsAt then id ascending",
            "items": {
              "$ref": "#/components/schemas/Slot"
            }
          }
        }
      },
      "BookSlotRequest": {
        "type": "object",
        "required": ["slotId", "customerName", "customerEmail"],
        "properties": {
          "slotId": {
            "type": "string",
            "format": "uuid",
            "description": "UUID of the slot to book",
            "example": "11111111-1111-4111-8111-111111111111"
          },
          "customerName": {
            "type": "string",
            "minLength": 1,
            "description": "Non-empty customer full name (trimmed)",
            "example": "Alex Morgan"
          },
          "customerEmail": {
            "type": "string",
            "format": "email",
            "description": "Valid customer email address (trimmed)",
            "example": "alex@example.com"
          }
        }
      },
      "Booking": {
        "type": "object",
        "required": ["id", "slotId", "customerName", "customerEmail", "status"],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "Unique identifier of the booking",
            "example": "22222222-2222-4222-8222-222222222222"
          },
          "slotId": {
            "type": "string",
            "format": "uuid",
            "description": "UUID of the associated appointment slot",
            "example": "11111111-1111-4111-8111-111111111111"
          },
          "customerName": {
            "type": "string",
            "description": "Customer full name",
            "example": "Alex Morgan"
          },
          "customerEmail": {
            "type": "string",
            "format": "email",
            "description": "Customer email address",
            "example": "alex@example.com"
          },
          "status": {
            "type": "string",
            "enum": ["active", "cancelled"],
            "description": "Current lifecycle status of the booking",
            "example": "active"
          }
        }
      },
      "BookingResponse": {
        "type": "object",
        "required": ["booking"],
        "properties": {
          "booking": {
            "$ref": "#/components/schemas/Booking"
          }
        }
      },
      "ErrorDetail": {
        "type": "object",
        "required": ["code", "message"],
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "VALIDATION_ERROR",
              "SLOT_NOT_FOUND",
              "BOOKING_NOT_FOUND",
              "SLOT_UNAVAILABLE",
              "INTERNAL_ERROR"
            ],
            "description": "Standardized machine-readable error code",
            "example": "SLOT_UNAVAILABLE"
          },
          "message": {
            "type": "string",
            "description": "Clear human-readable description of the error",
            "example": "This slot already has an active booking."
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        }
      }
    },
    "responses": {
      "InternalError": {
        "description": "Unexpected internal server failure.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "example": {
              "error": {
                "code": "INTERNAL_ERROR",
                "message": "An unexpected internal error occurred."
              }
            }
          }
        }
      }
    }
  }
}

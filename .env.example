# Port the API server listens on (default: 3000)
PORT=3000

# Server Host
HOST=0.0.0.0

# CORS Allowed Origin
CORS_ORIGIN=*

# PostgreSQL Database Connection URL (Prisma)
# Example: postgresql://postgres:postgres@localhost:5432/appointment_db?schema=public
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"

# Test Database Connection URL (Used during integration tests)
# Example: postgresql://postgres:postgres@localhost:5432/appointment_test_db?schema=public
TEST_DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/TEST_DATABASE?schema=public"

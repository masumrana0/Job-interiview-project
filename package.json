{
  "name": "appointment-booking-api",
  "version": "1.0.0",
  "description": "Appointment booking API with concurrency conflict prevention, Socket.IO real-time updates, and OpenAPI documentation.",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:push": "prisma db push",
    "seed": "tsx prisma/seed.ts",
    "test": "jest --runInBand --detectOpenHandles --forceExit",
    "test:watch": "jest --watch",
    "verify:socket": "tsx scripts/verify-socket.ts",
    "pack:zip": "tsx scripts/package-zip.ts"
  },
  "keywords": [
    "appointment-booking",
    "concurrency",
    "prisma",
    "express",
    "socket.io",
    "typescript",
    "openapi"
  ],
  "author": "Masum Rana",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^6.4.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "socket.io": "^4.8.1",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.3",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.1",
    "@types/supertest": "^6.0.2",
    "@types/swagger-ui-express": "^4.1.8",
    "archiver": "^7.0.1",
    "jest": "^29.7.0",
    "prisma": "^6.4.1",
    "socket.io-client": "^4.8.1",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}